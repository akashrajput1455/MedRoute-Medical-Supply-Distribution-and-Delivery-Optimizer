# ====================================================================
# MedRoute Environment Configuration Example
# Copy this file to .env and configure your local MySQL credentials
# ====================================================================

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=medroute_db

# Flask Application Settings
SECRET_KEY=medroute-mca-daa-secret-key-2026
FLASK_ENV=development
FLASK_DEBUG=1

# OSRM Public Demonstration Routing Service Endpoint
OSRM_API_URL=https://router.project-osrm.org

# Optional Demonstration SQLite Fallback (if local MySQL is offline)
ENABLE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=medroute_local.db
